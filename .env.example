# --- DATABASE CONFIGURATION ---
# Local development: jdbc:postgresql://localhost:5433/quiz_hub
# Docker Compose: jdbc:postgresql://quizhub-db:5432/quiz_hub
DB_URL=jdbc:postgresql://localhost:5433/quiz_hub
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# --- GOOGLE OAUTH2 CONFIGURATION ---
# Get these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- MAIL SERVER CONFIGURATION (GMAIL) ---
# Use App Password if 2FA is enabled
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# --- SECURITY CONFIGURATION ---
# Generate a long random string for JWT signing
JWT_SECRET=your_random_jwt_secret_at_least_64_characters_long
